# CrimeGraph AI — Frontend & Deployment Environment Variables
# Copy this file to .env for local environment configuration.
# DO NOT include private secrets, model credentials, or database keys in client-facing configuration.

# Backend API Service URL
CRIMEGRAPH_API_URL=http://127.0.0.1:8000

# Server Host & Port (for python run_server.py)
HOST=127.0.0.1
PORT=8000

# Application Environment (development | production)
NODE_ENV=production
