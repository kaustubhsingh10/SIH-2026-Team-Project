# ==============================================================================
# CrimeGraph AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Note: .env is listed in .gitignore and must never be committed.

# Application Environment (development / staging / production)
ENVIRONMENT=development

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Authentication & Security (Tier 1 Integration #2)
# Default placeholder secrets and passwords for development
CRIMEGRAPH_JWT_SECRET=replace_with_secure_production_jwt_secret_key_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
CRIMEGRAPH_AUTH_STRICT=false
CRIMEGRAPH_ADMIN_PASSWORD=placeholder_admin_password_2026
CRIMEGRAPH_ANALYST_PASSWORD=placeholder_analyst_password_2026
CRIMEGRAPH_USERS_PATH=data/users.json

# AI Model Configuration (Optional)
# If left empty, CrimeGraph AI uses high-precision deterministic grounded synthesis.
# If provided, enables Gemini API for natural-language explanation refinement.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=4.0
AI_MAX_RETRIES=1

# Backend & Data Layer Configuration
# For HttpCrimeGraphProvider or remote backend connections:
BACKEND_URL=http://127.0.0.1:8000
# Optional custom dataset path override (defaults to data/synthetic_data.json)
# DATASET_PATH=data/synthetic_data.json

# CORS Configuration
# Allowed origins for frontend clients (comma-separated or wildcard for dev)
CORS_ORIGINS=*
CORS_ALLOW_ORIGINS=*
CRIMEGRAPH_MANUAL_DATA_PATH=data/manual_data.json
